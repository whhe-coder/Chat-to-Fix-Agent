{
  "dataDir": "/data/chat-to-fix",
  "worktreesDir": "/data/chat-to-fix/worktrees",
  "httpPort": 3090,
  "language": "zh",
  "apiModel": "anthropic/CHANGE-ME",
  "codingModel": "anthropic/claude-sonnet-5-5",
  "codingEffort": "high",
  "adapters": { "slack": "fake", "jira": "fake", "gitlab": "fake" },
  "jira": { "baseUrl": "https://your-company.atlassian.net", "email": "bot@example.com", "fields": {} },
  "gitlab": { "baseUrl": "https://gitlab.example.com" },
  "slack": {},
  "bindings": [
    {
      "channel": "C0456",
      "repo": "group/project",
      "localRepo": "/data/repos/project",
      "remote": "/data/repos/project.git",
      "defaultBranch": "master",
      "jiraProject": "DEMO",
      "issueType": "Bug",
      "labels": ["chat-to-fix"],
      "testCommands": ["sh test.sh"],
      "setupCommands": [],
      "jiraFields": {},
      "ciJobs": [{ "name": "test", "command": "sh test.sh" }]
    }
  ],
  "jiraTransitions": ["In Review"],
  "commitAuthor": { "name": "chat-to-fix", "email": "chat-to-fix@example.com" },
  "limits": {
    "softTaskMinutes": 20,
    "softTaskUsd": 2.5,
    "taskMinutes": 80,
    "stepMinutes": { "fetch": 5, "issue": 5, "prepare": 10, "code": 40, "mr": 5, "ci": 30, "writeback": 5 },
    "quietMinutes": 3,
    "quietNudges": 2,
    "engineSilentMinutes": 10,
    "codingMaxSteps": 200,
    "testMinutes": 10,
    "reviewMinutes": 15,
    "reviewMaxRounds": 3,
    "maxConcurrent": 1,
    "queueMax": 20,
    "queueWaitHours": 4,
    "worktreeKeepDays": 7,
    "toolTimeoutSeconds": 30,
    "toolRetries": 2,
    "diffMaxFiles": 20,
    "diffMaxLines": 500,
    "replyMaxChars": 600,
    "ciPollSeconds": 15,
    "ciWaitMinutes": 30,
    "ciTotalMinutes": 90,
    "ciMaxRounds": 3,
    "ciLogMaxChars": 12000
  }
}
