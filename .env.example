# 复制为 .env.local 后填写本机值；来源和保存说明见 config/local-env/README.md。

# 本地服务
PORT=4000

# 模拟 Slack Bot（无需 Slack token）
MOCK_SLACK_PORT=4001

# Slack Socket Mode
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Slack Bot 调 Chat-to-Fix 的业务接口（见 spec/slackbot.md）
CHAT_TO_FIX_API_URL=http://127.0.0.1:3090
# Chat-to-Fix 启动后 <数据目录>/http-token 里的值；也可存进钥匙串
CHAT_TO_FIX_API_TOKEN=
# 发件箱游标保存目录，默认 .local/
SLACK_BOT_STATE_DIR=

# Agent 接入（频道 ID 在 Slack 安装获批后填写；Slack Bot 也只接受这个频道）
CHAT_TO_FIX_SLACK_CHANNEL=
CHAT_TO_FIX_LOCAL_REPO=
CHAT_TO_FIX_JIRA_SITE_URL=
CHAT_TO_FIX_WORK_TYPE=Tech Research

# GitLab
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.loc
GITLAB_PROJECT=account-platform/free-to-play-pc
GITLAB_BRANCH=master

# Jira
JIRA_TOKEN=
JIRA_CLOUD_ID=
JIRA_BOARD_ID=
JIRA_EMAIL=
JIRA_WORK_TYPE_FIELD_ID=
