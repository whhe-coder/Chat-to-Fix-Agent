# 复制为 .env.local 后填写本机值；来源和保存说明见 config/local-env/README.md。

# npm start 自动启动 Agent 和模拟频道；也可单独以前台方式启动模拟频道
MOCK_SLACK_PORT=4001
MOCK_SLACK_AGENT_URL=http://127.0.0.1:3090
MOCK_SLACK_STATE_DIR=

# Slack Socket Mode
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Slack Bot 连本机 Agent（npm run start:slack）；令牌留空时读 Agent 数据目录的 http-token
CHAT_TO_FIX_API_URL=http://127.0.0.1:3090
CHAT_TO_FIX_HTTP_TOKEN=
SLACK_BOT_STATE_DIR=

# 模型：Agent 的五个 bot（主、Slack、Jira、Pipeline、修复 bot 及其评审）都在 DSH 里运行，共用这一个 Anthropic API key。
# 必填；不再使用本机登录的 Claude Code。说明见 docs/chat-to-fix/configuration.md。
ANTHROPIC_API_KEY=
# 可选：模型线路，默认都是 anthropic/claude-sonnet-5-5
CHAT_TO_FIX_API_MODEL=
CHAT_TO_FIX_CODING_MODEL=

# Agent 接入（Slack 未接入时，npm start 暂用本机频道 CLOCAL）
CHAT_TO_FIX_SLACK_CHANNEL=
CHAT_TO_FIX_LOCAL_REPO=
CHAT_TO_FIX_JIRA_SITE_URL=
CHAT_TO_FIX_WORK_TYPE=Tech Research

# GitLab
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.loc
GITLAB_PROJECT=account-platform/free-to-play-pc
GITLAB_BRANCH=master

# Jira
JIRA_TOKEN=
JIRA_CLOUD_ID=
JIRA_BOARD_ID=
JIRA_EMAIL=
JIRA_WORK_TYPE_FIELD_ID=
