{
  "name": "chat-to-fix-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "sh -c '. src/chat-to-fix/scripts/dev-env.sh; exec node src/chat-to-fix/scripts/connected.ts --start'",
    "start:slack": "node src/slackBot/slack-bot.js",
    "start:mock-slack": "node src/slackBot/start-mock.js",
    "check:jira": "node src/jira/check-board.js",
    "start:agent": "sh src/chat-to-fix/scripts/start-chat-to-fix.sh",
    "stop:agent": "sh src/chat-to-fix/scripts/stop-chat-to-fix.sh",
    "check:agent-connections": "sh -c '. src/chat-to-fix/scripts/dev-env.sh; exec node src/chat-to-fix/scripts/connected.ts --check'",
    "prepare:agent-connections": "sh -c '. src/chat-to-fix/scripts/dev-env.sh; exec node src/chat-to-fix/scripts/connected.ts'",
    "smoke:agent": "cd src/chat-to-fix && node scripts/smoke.ts",
    "test": "npm run test:root && npm run test:agent && npm run test:agent-layer && npm run test:agent-bot",
    "test:root": "node --test \"test/*.test.js\"",
    "test:agent": "cd src/chat-to-fix && node --test \"test/*.test.ts\"",
    "test:agent-layer": "cd src/chat-to-fix && node --import ./bot/test/harness-resolve.ts --test --test-force-exit \"test/bot/*.test.ts\"",
    "test:agent-bot": "cd src/chat-to-fix/bot && node --import ./test/harness-resolve.ts --test --test-concurrency=6 --test-timeout=120000 --test-force-exit \"test/*.test.ts\"",
    "typecheck": "tsc -p src/chat-to-fix/tsconfig.json"
  },
  "dependencies": {
    "@slack/bolt": "4.7.3",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "deep-view": "0.1.2",
    "jsdom": "29.1.1",
    "oxlint": "1.76.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
